' ==================== PAQUETE: MODELOS ====================
package "modelos" #F0F8FF {

  abstract class Persona {
    - String codigo
    - String nombres
    - String apellidos
    - String telefono
    ..
    # Persona(String, String, String, String)
    + getCodigo() : String
    + getNombres() : String
    + getApellidos() : String
    + getTelefono() : String
    + getNombreCompleto() : String
    + setNombres(String) : void
    + setApellidos(String) : void
    + setTelefono(String) : void
  }

  class Paciente {
    - String dni
    - int edad
    - String genero
    - String tipoSangre
    - String alergias
    - String correo
    - boolean tieneSis
    - String numeroSis
    ..
    + getDni() : String
    + getEdad() : int
    + getGenero() : String
    + getTipoSangre() : String
    + getAlergias() : String
    + getCorreo() : String
    + isTieneSis() : boolean
    + getNumeroSis() : String
    + setDni(String) : void
    + setEdad(int) : void
    + setGenero(String) : void
    + setTipoSangre(String) : void
    + setAlergias(String) : void
    + setCorreo(String) : void
    + setTieneSis(boolean) : void
    + setNumeroSis(String) : void
    + toString() : String
  }

  class Medico {
    - String cmp
    - Especialidad especialidad
    - String correo
    - String turno
    ..
    + getCmp() : String
    + getEspecialidad() : Especialidad
    + getCorreo() : String
    + getTurno() : String
    + setCmp(String) : void
    + setEspecialidad(Especialidad) : void
    + setCorreo(String) : void
    + setTurno(String) : void
    + toString() : String
  }

  class Cita {
    - String codigo
    - Paciente paciente
    - Medico medico
    - Consultorio consultorio
    - String fecha
    - String hora
    - String motivo
    - double costoConsulta
    - EstadoCita estado
    ..
    + getCodigo() : String
    + getPaciente() : Paciente
    + getMedico() : Medico
    + getConsultorio() : Consultorio
    + getFecha() : String
    + getHora() : String
    + getMotivo() : String
    + getCostoConsulta() : double
    + getEstado() : EstadoCita
    + setPaciente(Paciente) : void
    + setMedico(Medico) : void
    + setConsultorio(Consultorio) : void
    + setFecha(String) : void
    + setHora(String) : void
    + setMotivo(String) : void
    + setCostoConsulta(double) : void
    + setEstado(EstadoCita) : void
    + toString() : String
  }

  class Consultorio {
    - String codigo
    - String nombre
    - int piso
    - Especialidad especialidad
    - boolean disponible
    ..
    + getCodigo() : String
    + getNombre() : String
    + getPiso() : int
    + isDisponible() : boolean
    + getEspecialidad() : Especialidad
    + setNombre(String) : void
    + setPiso(int) : void
    + setEspecialidad(Especialidad) : void
    + setDisponible(boolean) : void
    + toString() : String
  }

  class Medicamento {
    - String codigo
    - String nombre
    - String categoria
    - String descripcion
    - double precio
    - int stock
    ..
    + getCodigo() : String
    + getNombre() : String
    + getCategoria() : String
    + getDescripcion() : String
    + getPrecio() : double
    + getStock() : int
    + setNombre(String) : void
    + setCategoria(String) : void
    + setDescripcion(String) : void
    + setPrecio(double) : void
    + setStock(int) : void
    + toString() : String
  }

  class RegistroTriaje {
    - static int contador
    - String codigo
    - String codigoPaciente
    - String nombrePaciente
    - String fecha
    - double peso
    - double talla
    - double temperatura
    - String presionArterial
    - int frecuenciaCardiaca
    - String nivelPrioridad
    ..
    + getCodigo() : String
    + getCodigoPaciente() : String
    + getNombrePaciente() : String
    + getFecha() : String
    + getPeso() : double
    + getTalla() : double
    + getTemperatura() : double
    + getPresionArterial() : String
    + getFrecuenciaCardiaca() : int
    + getNivelPrioridad() : String
  }

  class ConsultaClinica {
    - static int contador
    - String codigo
    - String codigoPaciente
    - String nombrePaciente
    - String fecha
    - String nombreMedico
    - String especialidad
    - String diagnostico
    - String medicamentosRecetados
    - String observaciones
    ..
    + getCodigo() : String
    + getCodigoPaciente() : String
    + getNombrePaciente() : String
    + getFecha() : String
    + getNombreMedico() : String
    + getEspecialidad() : String
    + getDiagnostico() : String
    + getMedicamentosRecetados() : String
    + getObservaciones() : String
    + setDiagnostico(String) : void
    + setMedicamentosRecetados(String) : void
    + setObservaciones(String) : void
    + toString() : String
  }

  enum Especialidad {
    MEDICINA_GENERAL
    PEDIATRIA
    CARDIOLOGIA
    DERMATOLOGIA
    TRAUMATOLOGIA
    GINECOLOGIA
    ODONTOLOGIA
  }

  enum EstadoCita {
    PROGRAMADA
    EN_ESPERA
    ATENDIDA
    CANCELADA
  }

  Persona <|-- Paciente
  Persona <|-- Medico

  Cita *-- Paciente
  Cita *-- Medico
  Cita *-- Consultorio
  Cita *-- EstadoCita

  Medico *-- Especialidad
  Consultorio *-- Especialidad
}

' ==================== PAQUETE: ESTRUCTURAS ====================
package "estructuras" #FFF8F0 {

  class Nodo<T> {
    {field} T dato
    {field} Nodo<T> siguiente
  }

  class NodoDoble<T> {
    {field} T dato
    {field} NodoDoble<T> anterior
    {field} NodoDoble<T> siguiente
  }

  class ListaEnlazada<T> {
    - Nodo<T> cabeza
    - int tamanio
    ..
    + agregar(T) : void
    + obtener(int) : T
    + tamanio() : int
    + estaVacia() : boolean
    + reemplazar(int, T) : void
    + eliminar(int) : T
  }

  class ListaDoblementeEnlazada<T> {
    - NodoDoble<T> cabeza
    - NodoDoble<T> cola
    - NodoDoble<T> actual
    - int tamanio
    ..
    + agregarAlFinal(T) : void
    + irAlInicio() : void
    + irAlFinal() : void
    + anterior() : T
    + siguiente() : T
    + obtenerActual() : T
    + hayAnterior() : boolean
    + haySiguiente() : boolean
    + tamanio() : int
    + estaVacia() : boolean
  }

  interface Pila<T> {
    + push(T) : void
    + pop() : T
    + peek() : T
    + estaVacia() : boolean
    + tamanio() : int
  }

  class PilaEnlazada<T> {
    - Nodo<T> cima
    - int tamanio
    ..
    + push(T) : void
    + pop() : T
    + peek() : T
    + estaVacia() : boolean
    + tamanio() : int
  }

  class PilaArreglo<T> {
    - T[] elementos
    - int tope
    ..
    + push(T) : void
    + pop() : T
    + peek() : T
    + estaVacia() : boolean
    + tamanio() : int
  }

  interface Cola<T> {
    + enqueue(T) : void
    + dequeue() : T
    + peek() : T
    + estaVacia() : boolean
    + tamanio() : int
    + toArray(T[]) : T[]
  }

  class ColaEnlazada<T> {
    - Nodo<T> frente
    - Nodo<T> fin
    - int tamanio
    ..
    + enqueue(T) : void
    + dequeue() : T
    + peek() : T
    + estaVacia() : boolean
    + tamanio() : int
    + toArray(T[]) : T[]
  }

  class ColaArreglo<T> {
    - T[] elementos
    - int frente
    - int fin
    - int tamanio
    ..
    + enqueue(T) : void
    + dequeue() : T
    + peek() : T
    + estaVacia() : boolean
    + tamanio() : int
    + toArray(T[]) : T[]
  }

  class ColaPrioridad<T> {
    - NodoPrioridad<T> frente
    - int tamanio
    - Comparator<<T>> comparador
    ..
    + enqueue(T) : void
    + dequeue() : T
    + peek() : T
    + estaVacia() : boolean
    + tamanio() : int
    + toArray(T[]) : T[]
  }

  class ArbolBinarioBusqueda<K extends Comparable, V> {
    - NodoArbol<K,V> raiz
    ..
    + insertar(K, V) : void
    + buscar(K) : V
    + eliminar(K) : void
    + recorridoInorden() : ListaEnlazada<V>
    + recorridoPreorden() : ListaEnlazada<V>
    + recorridoPostorden() : ListaEnlazada<V>
  }

  ListaEnlazada *-- Nodo
  ListaDoblementeEnlazada *-- NodoDoble

  Pila <|.. PilaEnlazada
  Pila <|.. PilaArreglo
  PilaEnlazada *-- Nodo

  Cola <|.. ColaEnlazada
  Cola <|.. ColaArreglo
  Cola <|.. ColaPrioridad
  ColaEnlazada *-- Nodo
  ColaPrioridad *-- Nodo
}

