' ==================== PAQUETE: CONFIG ====================
package "config" #FFFFF0 {

  class AppConfig {
    - static AppConfig INSTANCE
    - Properties properties
    ..
    {static} + get() : AppConfig
    + getPersistenceMode() : PersistenceMode
    + getPostgresUrl() : String
    + getPostgresUser() : String
    + getPostgresPassword() : String
  }

  enum PersistenceMode {
    MEMORY
    POSTGRES
    {static} + from(String) : PersistenceMode
  }

  AppConfig *-- PersistenceMode
}

' ==================== PAQUETE: VISTA ====================
package "vista" #F5F0FF {

  class ventanaprincipal {
    - ClinicaSistema sistema
    ..
    + ventanaprincipal(ClinicaSistema)
  }

  class ventanalogin {
    {static} + mostrar(Component) : boolean
  }

  class ventanacarga {
    + mostrarBrevemente(Runnable) : void
  }

  class temaaplicacion
  class fuentesinterfaz
  class panelredondeado
  class panelfondo
  class panelencabezado
  class panelvidrio
  class botonlateral
  class tarjetaresumen
  class scrollredondeado
}

' ==================== PAQUETE: MAIN ====================
package "clinicamedica" #FFFFFF {

  class ClinicaMedica {
    {static} + main(String[]) : void
  }
}

